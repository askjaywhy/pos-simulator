{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Risk service fraud rules list",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["rule_id", "name", "description", "severity", "enabled", "params", "updated_at"],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^[A-Z_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["low", "medium", "high", "critical"] },
          "enabled": { "type": "boolean" },
          "params": { "type": "object" },
          "updated_at": { "type": "string" }
        }
      }
    }
  }
}
